{
  "name": "vscode-harbor-bronze",
  "displayName": "Harbor Bronze",
  "description": "A calm theme with teal and bronze accents, available in dark and light variants.",
  "version": "1.1.1",
  "publisher": "kototok903",
  "icon": "assets/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kototok903/vscode-harbor-bronze"
  },
  "bugs": {
    "url": "https://github.com/kototok903/vscode-harbor-bronze/issues",
    "email": "kototok903@gmail.com"
  },
  "galleryBanner": {
    "color": "#10191e",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "theme",
    "dark theme",
    "light theme",
    "teal",
    "bronze"
  ],
  "homepage": "https://github.com/kototok903/vscode-harbor-bronze",
  "scripts": {
    "check": "node scripts/check-themes.mjs",
    "icon": "node scripts/render-icon.mjs",
    "package": "npm run check && vsce package --allow-missing-repository"
  },
  "contributes": {
    "themes": [
      {
        "label": "Harbor Bronze Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/harbor-bronze-dark.json"
      },
      {
        "label": "Harbor Bronze Light",
        "uiTheme": "vs",
        "path": "./themes/harbor-bronze-light.json"
      },
      {
        "label": "Harbor Bronze Dark Borderless",
        "uiTheme": "vs-dark",
        "path": "./themes/harbor-bronze-dark-borderless.json"
      },
      {
        "label": "Harbor Bronze Light Borderless",
        "uiTheme": "vs",
        "path": "./themes/harbor-bronze-light-borderless.json"
      }
    ]
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@vscode/vsce": "^3.9.2"
  }
}
