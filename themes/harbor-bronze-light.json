  "tokenColors": [
    {
      "name": "Comments",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#657276", "fontStyle": "italic" }
    },
    {
      "name": "Strings",
      "scope": ["string", "string.quoted", "string.template"],
      "settings": { "foreground": "#765631" }
    },
    {
      "name": "String interpolation",
      "scope": [
        "punctuation.definition.template-expression",
        "meta.template.expression"
      ],
      "settings": { "foreground": "#283235" }
    },
    {
      "name": "Numbers and constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "variable.language"
      ],
      "settings": { "foreground": "#a13f3a" }
    },
    {
      "name": "Keywords and storage",
      "scope": ["keyword", "storage.type", "storage.modifier"],
      "settings": { "foreground": "#365f6e" }
    },
    {
      "name": "Operators",
      "scope": ["keyword.operator", "punctuation.accessor"],
      "settings": { "foreground": "#536164" }
    },
    {
      "name": "Functions and methods",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "variable.function"
      ],
      "settings": { "foreground": "#47798a" }
    },
    {
      "name": "Types and classes",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.struct",
        "entity.name.interface",
        "support.type",
        "support.class"
      ],
      "settings": { "foreground": "#416b61" }
    },
    {
      "name": "Properties and attributes",
      "scope": [
        "variable.other.property",
        "support.variable.property",
        "entity.other.attribute-name"
      ],
      "settings": { "foreground": "#805f43" }
    },
    {
      "name": "Parameters and variables",
      "scope": [
        "variable",
        "variable.parameter",
        "meta.definition.variable.name"
      ],
      "settings": { "foreground": "#283235" }
    },
    {
      "name": "Tags",
      "scope": ["entity.name.tag", "punctuation.definition.tag"],
      "settings": { "foreground": "#365f6e" }
    },
    {
      "name": "Regex",
      "scope": ["string.regexp", "constant.other.character-class.regexp"],
      "settings": { "foreground": "#3f7d63" }
    },
    {
      "name": "Invalid",
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#a92e38" }
    },
    {
      "name": "Markdown headings",
      "scope": ["markup.heading", "entity.name.section.markdown"],
      "settings": { "foreground": "#365f6e", "fontStyle": "bold" }
    },
    {
      "name": "Markdown links",
      "scope": [
        "markup.underline.link",
        "string.other.link",
        "meta.link.inline.markdown"
      ],
      "settings": { "foreground": "#47798a", "fontStyle": "underline" }
    },
    {
      "name": "Markup bold",
      "scope": ["markup.bold"],
      "settings": { "foreground": "#825324", "fontStyle": "bold" }
    },
    {
      "name": "Markup italic",
      "scope": ["markup.italic"],
      "settings": { "foreground": "#416b61", "fontStyle": "italic" }
    },
    {
      "name": "Diff inserted",
      "scope": ["markup.inserted", "meta.diff.header.to-file"],
      "settings": { "foreground": "#3f7d63" }
    },
    {
      "name": "Diff deleted",
      "scope": ["markup.deleted", "meta.diff.header.from-file"],
      "settings": { "foreground": "#a92e38" }
    },
    {
      "name": "Diff changed",
      "scope": ["markup.changed"],
      "settings": { "foreground": "#825324" }
    }
  ],
  "semanticTokenColors": {
    "comment": { "foreground": "#657276", "italic": true },
    "string": "#765631",
    "number": "#a13f3a",
    "keyword": "#365f6e",
    "operator": "#536164",
    "function": "#47798a",
    "method": "#47798a",
    "class": "#416b61",
    "interface": "#416b61",
    "struct": "#416b61",
    "type": "#416b61",
    "typeParameter": "#416b61",
    "enum": "#416b61",
    "enumMember": "#a13f3a",
    "property": "#805f43",
    "parameter": "#283235",
    "variable.readonly": "#a13f3a",
    "decorator": "#825324",
    "namespace": "#51736f",
    "regexp": "#3f7d63"
  }
}
