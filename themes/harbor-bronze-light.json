  "tokenColors": [
    {
      "name": "Comments",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#657276", "fontStyle": "italic" }
    },
    {
      "name": "Strings",
      "scope": ["string", "string.quoted", "string.template"],
      "settings": { "foreground": "#56743f" }
    },
    {
      "name": "JSON property names",
      "scope": [
        "support.type.property-name.json",
        "support.type.property-name.json.comments"
      ],
      "settings": { "foreground": "#365f6e" }
    },
    {
      "name": "String interpolation",
      "scope": [
        "punctuation.definition.template-expression",
        "meta.template.expression"
      ],
      "settings": { "foreground": "#283235" }
    },
    {
      "name": "Numbers and literals",
      "scope": ["constant.numeric", "constant.language", "constant.character"],
      "settings": { "foreground": "#796851" }
    },
    {
      "name": "Language variables",
      "scope": ["variable.language"],
      "settings": { "foreground": "#365f6e" }
    },
    {
      "name": "Keywords and storage",
      "scope": ["keyword", "storage.type", "storage.modifier"],
      "settings": { "foreground": "#a13f3a" }
    },
    {
      "name": "Operators",
      "scope": ["keyword.operator", "punctuation.accessor"],
      "settings": { "foreground": "#536164" }
    },
    {
      "name": "Word operators",
      "scope": [
        "keyword.operator.new",
        "keyword.operator.expression.new",
        "keyword.operator.instanceof",
        "keyword.operator.expression.instanceof",
        "keyword.operator.keyof",
        "keyword.operator.expression.keyof",
        "keyword.operator.delete",
        "keyword.operator.expression.delete",
        "keyword.operator.in",
        "keyword.operator.expression.in",
        "keyword.operator.of",
        "keyword.operator.expression.of",
        "keyword.operator.typeof",
        "keyword.operator.expression.typeof",
        "keyword.operator.void",
        "keyword.operator.expression.void",
        "keyword.operator.sizeof",
        "keyword.operator.logical.python"
      ],
      "settings": { "foreground": "#a13f3a" }
    },
    {
      "name": "Functions and methods",
      "scope": [
        "support.function",
        "entity.name.function",
        "meta.function-call.generic.python",
        "variable.function"
      ],
      "settings": { "foreground": "#825324" }
    },
    {
      "name": "Python function and method declarations",
      "scope": ["meta.function.python entity.name.function.python"],
      "settings": { "foreground": "#825324", "fontStyle": "bold" }
    },
    {
      "name": "Types, classes, interfaces, and enums",
      "scope": [
        "entity.name.type",
        "entity.name.struct",
        "entity.name.class",
        "entity.name.interface",
        "entity.name.enum",
        "entity.other.inherited-class"
      ],
      "settings": { "foreground": "#365f6e" }
    },
    {
      "name": "Library and support types",
      "scope": ["support.type", "support.class"],
      "settings": { "foreground": "#365f6e" }
    },
    {
      "name": "Primitive types",
      "scope": [
        "support.type.primitive",
        "storage.type.primitive",
        "storage.type.boolean.go",
        "storage.type.byte.go",
        "storage.type.error.go",
        "storage.type.numeric.go",
        "storage.type.rune.go",
        "storage.type.string.go",
        "storage.type.uintptr.go",
        "entity.name.type.any.go",
        "entity.name.type.comparable.go"
      ],
      "settings": { "foreground": "#a13f3a" }
    },
    {
      "name": "Properties and attributes",
      "scope": [
        "variable.other.property",
        "support.variable.property",
        "entity.other.attribute-name"
      ],
      "settings": { "foreground": "#796851" }
    },
    {
      "name": "Variables",
      "scope": ["variable", "meta.definition.variable.name"],
      "settings": { "foreground": "#283235" }
    },
    {
      "name": "Parameters",
      "scope": ["variable.parameter"],
      "settings": { "foreground": "#283235", "fontStyle": "italic" }
    },
    {
      "name": "Tags",
      "scope": ["entity.name.tag", "punctuation.definition.tag"],
      "settings": { "foreground": "#365f6e" }
    },
    {
      "name": "Regex",
      "scope": ["string.regexp", "constant.other.character-class.regexp"],
      "settings": { "foreground": "#3f7d63" }
    },
    {
      "name": "Invalid",
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#a92e38" }
    },
    {
      "name": "Markdown headings",
      "scope": ["markup.heading", "entity.name.section.markdown"],
      "settings": { "foreground": "#796851", "fontStyle": "bold" }
    },
    {
      "name": "Markdown link destinations",
      "scope": ["markup.underline.link"],
      "settings": { "foreground": "#365f6e", "fontStyle": "underline" }
    },
    {
      "name": "Markdown link text",
      "scope": ["string.other.link"],
      "settings": { "foreground": "#365f6e", "fontStyle": "" }
    },
    {
      "name": "Markup bold",
      "scope": ["markup.bold"],
      "settings": { "foreground": "#416b61", "fontStyle": "bold" }
    },
    {
      "name": "Markup italic",
      "scope": ["markup.italic"],
      "settings": { "foreground": "#416b61", "fontStyle": "italic" }
    },
    {
      "name": "Markup bold and italic",
      "scope": ["markup.bold markup.italic", "markup.italic markup.bold"],
      "settings": { "foreground": "#416b61", "fontStyle": "bold italic" }
    },
    {
      "name": "Diff inserted",
      "scope": ["markup.inserted", "meta.diff.header.to-file"],
      "settings": { "foreground": "#3f7d63" }
    },
    {
      "name": "Diff deleted",
      "scope": ["markup.deleted", "meta.diff.header.from-file"],
      "settings": { "foreground": "#a92e38" }
    },
    {
      "name": "Diff changed",
      "scope": ["markup.changed"],
      "settings": { "foreground": "#365f6e" }
    }
  ],
  "semanticTokenColors": {
    "comment": { "foreground": "#657276", "italic": true },
    "string": "#56743f",
    "number": "#796851",
    "keyword": "#a13f3a",
    "operator": "#536164",
    "function": "#825324",
    "method": "#825324",
    "function.declaration": { "foreground": "#825324", "bold": true },
    "method.declaration": { "foreground": "#825324", "bold": true },
    "class": "#365f6e",
    "class.defaultLibrary": "#365f6e",
    "interface": "#365f6e",
    "interface.defaultLibrary": "#365f6e",
    "struct": "#365f6e",
    "struct.defaultLibrary": "#365f6e",
    "type": "#365f6e",
    "type.defaultLibrary": "#365f6e",
    "type.defaultLibrary:go": "#a13f3a",
    "typeParameter": "#365f6e",
    "enum": "#365f6e",
    "enum.defaultLibrary": "#365f6e",
    "enumMember": "#796851",
    "property": "#796851",
    "parameter": { "foreground": "#283235", "italic": true },
    "variable": "#283235",
    "variable.readonly": "#283235",
    "decorator": "#825324",
    "namespace": "#51736f",
    "regexp": "#3f7d63"
  }
}
