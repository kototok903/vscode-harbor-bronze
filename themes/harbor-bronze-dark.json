  "tokenColors": [
    {
      "name": "Comments",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#737e83", "fontStyle": "italic" }
    },
    {
      "name": "Strings",
      "scope": ["string", "string.quoted", "string.template"],
      "settings": { "foreground": "#c4ad82" }
    },
    {
      "name": "String interpolation",
      "scope": [
        "punctuation.definition.template-expression",
        "meta.template.expression"
      ],
      "settings": { "foreground": "#ced1ce" }
    },
    {
      "name": "Numbers and constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "variable.language"
      ],
      "settings": { "foreground": "#d48e80" }
    },
    {
      "name": "Keywords and storage",
      "scope": ["keyword", "storage.type", "storage.modifier"],
      "settings": { "foreground": "#74aabd" }
    },
    {
      "name": "Operators",
      "scope": ["keyword.operator", "punctuation.accessor"],
      "settings": { "foreground": "#aab3b1" }
    },
    {
      "name": "Functions and methods",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "variable.function"
      ],
      "settings": { "foreground": "#91b1b4" }
    },
    {
      "name": "Types and classes",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.struct",
        "entity.name.interface",
        "support.type",
        "support.class"
      ],
      "settings": { "foreground": "#abc2ba" }
    },
    {
      "name": "Properties and attributes",
      "scope": [
        "variable.other.property",
        "support.variable.property",
        "entity.other.attribute-name"
      ],
      "settings": { "foreground": "#b9a276" }
    },
    {
      "name": "Parameters and variables",
      "scope": [
        "variable",
        "variable.parameter",
        "meta.definition.variable.name"
      ],
      "settings": { "foreground": "#ced1ce" }
    },
    {
      "name": "Tags",
      "scope": ["entity.name.tag", "punctuation.definition.tag"],
      "settings": { "foreground": "#74aabd" }
    },
    {
      "name": "Regex",
      "scope": ["string.regexp", "constant.other.character-class.regexp"],
      "settings": { "foreground": "#89bda6" }
    },
    {
      "name": "Invalid",
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#f1ece6" }
    },
    {
      "name": "Markdown headings",
      "scope": ["markup.heading", "entity.name.section.markdown"],
      "settings": { "foreground": "#74aabd", "fontStyle": "bold" }
    },
    {
      "name": "Markdown links",
      "scope": [
        "markup.underline.link",
        "string.other.link",
        "meta.link.inline.markdown"
      ],
      "settings": { "foreground": "#91b1b4", "fontStyle": "underline" }
    },
    {
      "name": "Markup bold",
      "scope": ["markup.bold"],
      "settings": { "foreground": "#d2a371", "fontStyle": "bold" }
    },
    {
      "name": "Markup italic",
      "scope": ["markup.italic"],
      "settings": { "foreground": "#abc2ba", "fontStyle": "italic" }
    },
    {
      "name": "Diff inserted",
      "scope": ["markup.inserted", "meta.diff.header.to-file"],
      "settings": { "foreground": "#70b598" }
    },
    {
      "name": "Diff deleted",
      "scope": ["markup.deleted", "meta.diff.header.from-file"],
      "settings": { "foreground": "#e8757b" }
    },
    {
      "name": "Diff changed",
      "scope": ["markup.changed"],
      "settings": { "foreground": "#d2a371" }
    }
  ],
  "semanticTokenColors": {
    "comment": { "foreground": "#737e83", "italic": true },
    "string": "#c4ad82",
    "number": "#d48e80",
    "keyword": "#74aabd",
    "operator": "#aab3b1",
    "function": "#91b1b4",
    "method": "#91b1b4",
    "class": "#abc2ba",
    "interface": "#abc2ba",
    "struct": "#abc2ba",
    "type": "#abc2ba",
    "typeParameter": "#abc2ba",
    "enum": "#abc2ba",
    "enumMember": "#d48e80",
    "property": "#b9a276",
    "parameter": "#ced1ce",
    "variable.readonly": "#d48e80",
    "decorator": "#d2a371",
    "namespace": "#9eb7ad",
    "regexp": "#89bda6"
  }
}
