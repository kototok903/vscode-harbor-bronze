  "tokenColors": [
    {
      "name": "Comments",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#737e83", "fontStyle": "italic" }
    },
    {
      "name": "Strings",
      "scope": ["string", "string.quoted", "string.template"],
      "settings": { "foreground": "#a9c989" }
    },
    {
      "name": "JSON property names",
      "scope": [
        "support.type.property-name.json",
        "support.type.property-name.json.comments"
      ],
      "settings": { "foreground": "#74aabd" }
    },
    {
      "name": "String interpolation",
      "scope": [
        "punctuation.definition.template-expression",
        "meta.template.expression"
      ],
      "settings": { "foreground": "#ced1ce" }
    },
    {
      "name": "Numbers and literals",
      "scope": ["constant.numeric", "constant.language", "constant.character"],
      "settings": { "foreground": "#c2b18f" }
    },
    {
      "name": "Language variables",
      "scope": ["variable.language"],
      "settings": { "foreground": "#74aabd" }
    },
    {
      "name": "Keywords and storage",
      "scope": ["keyword", "storage.type", "storage.modifier"],
      "settings": { "foreground": "#d48e80" }
    },
    {
      "name": "Operators",
      "scope": ["keyword.operator", "punctuation.accessor"],
      "settings": { "foreground": "#aab3b1" }
    },
    {
      "name": "Word operators",
      "scope": [
        "keyword.operator.new",
        "keyword.operator.expression.new",
        "keyword.operator.instanceof",
        "keyword.operator.expression.instanceof",
        "keyword.operator.keyof",
        "keyword.operator.expression.keyof",
        "keyword.operator.delete",
        "keyword.operator.expression.delete",
        "keyword.operator.in",
        "keyword.operator.expression.in",
        "keyword.operator.of",
        "keyword.operator.expression.of",
        "keyword.operator.typeof",
        "keyword.operator.expression.typeof",
        "keyword.operator.void",
        "keyword.operator.expression.void",
        "keyword.operator.sizeof",
        "keyword.operator.logical.python"
      ],
      "settings": { "foreground": "#d48e80" }
    },
    {
      "name": "Functions and methods",
      "scope": [
        "support.function",
        "entity.name.function",
        "meta.function-call.generic.python",
        "variable.function"
      ],
      "settings": { "foreground": "#d2a371" }
    },
    {
      "name": "Python function and method declarations",
      "scope": ["meta.function.python entity.name.function.python"],
      "settings": { "foreground": "#d2a371", "fontStyle": "bold" }
    },
    {
      "name": "Types, classes, interfaces, and enums",
      "scope": [
        "entity.name.type",
        "entity.name.struct",
        "entity.name.class",
        "entity.name.interface",
        "entity.name.enum",
        "entity.other.inherited-class"
      ],
      "settings": { "foreground": "#74aabd" }
    },
    {
      "name": "Library and support types",
      "scope": ["support.type", "support.class"],
      "settings": { "foreground": "#74aabd" }
    },
    {
      "name": "Primitive types",
      "scope": [
        "support.type.primitive",
        "storage.type.primitive",
        "storage.type.boolean.go",
        "storage.type.byte.go",
        "storage.type.error.go",
        "storage.type.numeric.go",
        "storage.type.rune.go",
        "storage.type.string.go",
        "storage.type.uintptr.go",
        "entity.name.type.any.go",
        "entity.name.type.comparable.go"
      ],
      "settings": { "foreground": "#d48e80" }
    },
    {
      "name": "Properties and attributes",
      "scope": [
        "variable.other.property",
        "support.variable.property",
        "entity.other.attribute-name"
      ],
      "settings": { "foreground": "#c2b18f" }
    },
    {
      "name": "Variables",
      "scope": ["variable", "meta.definition.variable.name"],
      "settings": { "foreground": "#ced1ce" }
    },
    {
      "name": "Parameters",
      "scope": ["variable.parameter"],
      "settings": { "foreground": "#ced1ce", "fontStyle": "italic" }
    },
    {
      "name": "Tags",
      "scope": ["entity.name.tag", "punctuation.definition.tag"],
      "settings": { "foreground": "#74aabd" }
    },
    {
      "name": "Regex",
      "scope": ["string.regexp", "constant.other.character-class.regexp"],
      "settings": { "foreground": "#89bda6" }
    },
    {
      "name": "Invalid",
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#e8757b" }
    },
    {
      "name": "Markdown headings",
      "scope": ["markup.heading", "entity.name.section.markdown"],
      "settings": {"foreground": "#c2b18f", "fontStyle": "bold"}
    },
    {
      "name": "Markdown link destinations",
      "scope": ["markup.underline.link"],
      "settings": {"foreground": "#74aabd", "fontStyle": "underline"}
    },
    {
      "name": "Markdown link text",
      "scope": ["string.other.link"],
      "settings": {"foreground": "#74aabd", "fontStyle": ""}
    },
    {
      "name": "Markup bold",
      "scope": ["markup.bold"],
      "settings": {"foreground": "#abc2ba", "fontStyle": "bold"}
    },
    {
      "name": "Markup italic",
      "scope": ["markup.italic"],
      "settings": {"foreground": "#abc2ba", "fontStyle": "italic"}
    },
    {
      "name": "Markup bold and italic",
      "scope": ["markup.bold markup.italic", "markup.italic markup.bold"],
      "settings": {"foreground": "#abc2ba", "fontStyle": "bold italic"}
    },
    {
      "name": "Diff inserted",
      "scope": ["markup.inserted", "meta.diff.header.to-file"],
      "settings": { "foreground": "#70b598" }
    },
    {
      "name": "Diff deleted",
      "scope": ["markup.deleted", "meta.diff.header.from-file"],
      "settings": { "foreground": "#e8757b" }
    },
    {
      "name": "Diff changed",
      "scope": ["markup.changed"],
      "settings": { "foreground": "#74aabd" }
    }
  ],
  "semanticTokenColors": {
    "comment": { "foreground": "#737e83", "italic": true },
    "string": "#a9c989",
    "number": "#c2b18f",
    "keyword": "#d48e80",
    "operator": "#aab3b1",
    "function": "#d2a371",
    "method": "#d2a371",
    "function.declaration": { "foreground": "#d2a371", "bold": true },
    "method.declaration": { "foreground": "#d2a371", "bold": true },
    "class": "#74aabd",
    "class.defaultLibrary": "#74aabd",
    "interface": "#74aabd",
    "interface.defaultLibrary": "#74aabd",
    "struct": "#74aabd",
    "struct.defaultLibrary": "#74aabd",
    "type": "#74aabd",
    "type.defaultLibrary": "#74aabd",
    "type.defaultLibrary:go": "#d48e80",
    "typeParameter": "#74aabd",
    "enum": "#74aabd",
    "enum.defaultLibrary": "#74aabd",
    "enumMember": "#c2b18f",
    "property": "#c2b18f",
    "parameter": { "foreground": "#ced1ce", "italic": true },
    "variable": "#ced1ce",
    "variable.readonly": "#ced1ce",
    "decorator": "#d2a371",
    "namespace": "#9eb7ad",
    "regexp": "#89bda6"
  }
}
